/**
 * Strict type-checking migration — COMPLETE.
 *
 * All production `as any` usages removed (369 → 0).
 * `strictNullChecks: true` and `noImplicitAny: true` now live in tsconfig.json.
 *
 * This file is retained for running additional strict checks during CI:
 *   tsc --project tsconfig.strict.json --noEmit
 *
 * Flags enabled beyond tsconfig.json defaults:
 *   - strictBindCallApply
 *   - noFallthroughCasesInSwitch
 *   - noUncheckedIndexedAccess (aspirational — not yet in main config)
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strictBindCallApply":       true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess":  true,
    "noEmit":                    true
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts"
  ]
}
