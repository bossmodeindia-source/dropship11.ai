# ─────────────────────────────────────────────────────────────────────────────
# AI Empire V63 — Complete Environment Variables Reference
#
# REQUIRED vars are marked [REQUIRED].
# Optional vars fall back to safe defaults or MOCK mode.
#
# SECRET GENERATION (run once, save in password manager):
#   JWT_SECRET:            openssl rand -base64 48
#   JWT_REFRESH_SECRET:    openssl rand -base64 48
#   WEBHOOK_HMAC_SECRET:   openssl rand -hex 32
#   ENCRYPTION_MASTER_KEY: openssl rand -hex 32
#   INTERNAL_SERVICE_KEY:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (Supabase recommended) ──────────────────────────────────────────
# [REQUIRED] Transaction mode (pgbouncer) — for API + Worker
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session mode — for migrations only (bypasses pgbouncer DDL restrictions)
DATABASE_URL_DIRECT=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_SSL=true

# ── Redis (Railway Redis add-on sets REDIS_URL automatically) ─────────────────
# [REQUIRED] Railway Redis: injected automatically. Upstash TLS: rediss://...
REDIS_URL=redis://localhost:6379
# Alternative if no REDIS_URL:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=                          # [REQUIRED] openssl rand -base64 48
JWT_REFRESH_SECRET=                  # [REQUIRED] openssl rand -base64 48
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Security ──────────────────────────────────────────────────────────────────
ENCRYPTION_MASTER_KEY=               # [REQUIRED] openssl rand -hex 32
WEBHOOK_HMAC_SECRET=                 # [REQUIRED] openssl rand -hex 32
SHOPIFY_WEBHOOK_SECRET=              # [REQUIRED in production] Shopify Partner dashboard
INTERNAL_SERVICE_KEY=                # [REQUIRED] openssl rand -hex 32

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://app.aiempirebot.com,https://aiempirebot.com

# ── Swagger ───────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=false

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Telegram (Bot + Auth + Storage) ──────────────────────────────────────────
# Used for: admin alerts, Telegram Login Widget, storage bot pool
TELEGRAM_BOT_TOKEN=                  # [OPTIONAL] your @BotFather bot token
TELEGRAM_ADMIN_CHAT_ID=              # [OPTIONAL] admin chat/group ID for alerts
TELEGRAM_STORAGE_MASTER_BOT_TOKEN=   # [OPTIONAL] dedicated storage bot token
TG_BOT_DEFAULT_CAPACITY=100
TG_COLD_ARCHIVE_DAYS=30

# ── Meta / Facebook Ads ───────────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_APP_SECRET=
META_AD_ACCOUNT_ID=act_000000000
META_PAGE_ID=
META_INR_TO_USD_RATE=0.012
ROAS_SCALE_THRESHOLD=2
META_ASSUMED_AOV=50

# ── Platform Limits ───────────────────────────────────────────────────────────
EMPIRE_MAX_DAILY_SPEND=100000
PLATFORM_ASSUMED_LTV_INR=3000
PLATFORM_SIGNUP_URL=https://app.aiempirebot.com/signup
APP_BASE_URL=https://app.aiempirebot.com

# ── AI Providers (all optional — empty = MOCK mode) ───────────────────────────
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_49B_API_KEY=
NVIDIA_STRATEGY_253B_API_KEY=
NEMUOGUARD_API_KEY=
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai
AI_MEDIA_API_KEY=                    # [RECOMMENDED] real MuAPI key for image gen
AI_MEDIA_BASE_URL=https://api.muapi.ai

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@aiempirebot.com

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=             # [REQUIRED for subscriptions]

# ── Supplier ──────────────────────────────────────────────────────────────────
SUPPLIER_API_URL=https://mock-supplier.internal/api
TREND_API_URL=
TREND_API_KEY=

# ── Alerting ──────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
ADMIN_ALERT_EMAIL=ops@aiempirebot.com

# ── Shopify ───────────────────────────────────────────────────────────────────
# Per-user Shopify API keys are stored in vault — no global key needed.

# ── Social APIs (organic growth) ──────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDITS=entrepreneur,ecommerce,dropshipping,marketing

# ── Empire Limits ─────────────────────────────────────────────────────────────
EMPIRE_MAX_STORES=20
EMPIRE_MAX_EXPOSURE_INR=500000
EMPIRE_LOSS_THRESHOLD_PCT=15
EMPIRE_SEED_CAPITAL_INR=100000

# ── Organic Growth ────────────────────────────────────────────────────────────
V43_ORGANIC_MODE=HYBRID
V43_LOOP_INTERVAL_HOURS=6
V43_AUTO_START=true

# ── Video Pipeline (V61) ──────────────────────────────────────────────────────
# FFmpeg is installed via nixpacks.toml on Railway / Dockerfile on Docker.
# No env vars needed — video pipeline uses AI_MEDIA_API_KEY for image generation.

# ── Chaos (NEVER true in production) ─────────────────────────────────────────
CHAOS_MODE=false

# ── V65: OpenTelemetry Distributed Tracing ────────────────────────────────────
# Set OTEL_DISABLED=true to disable tracing (development default)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=aiempire-api
OTEL_SAMPLING_RATIO=0.1
OTEL_DISABLED=false
# For the worker process, override with:
# OTEL_SERVICE_NAME=aiempire-worker
