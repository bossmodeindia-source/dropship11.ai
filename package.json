{
  "name": "aiempire-nestjs-app",
  "version": "69.0.0",
  "description": "AI Empire — V69 Enterprise Architecture Certified | Single Orchestrator | Drizzle-Only | Zero Legacy Debt",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc --outDir dist/scripts --skipLibCheck --esModuleInterop --module commonjs --target ES2021 scripts/migrate.ts",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:check": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write eslint.config.mjs .prettierrc.json semgrep.yml trivy.yaml .github/**/*.yml package.json PHASE9_SECURITY_REPORT.md PHASE10_CONTRACT_REPORT.md OPENAPI_CONTRACT_CERTIFICATION.md PLAYWRIGHT_CERTIFICATION_REPORT.md SECURITY_CI_CERTIFICATION_REPORT.md",
    "format:check": "prettier --check eslint.config.mjs .prettierrc.json semgrep.yml trivy.yaml .github/**/*.yml package.json PHASE9_SECURITY_REPORT.md PHASE10_CONTRACT_REPORT.md OPENAPI_CONTRACT_CERTIFICATION.md PLAYWRIGHT_CERTIFICATION_REPORT.md SECURITY_CI_CERTIFICATION_REPORT.md",
    "security:audit": "npm audit --audit-level=high",
    "security:audit-npm": "npm audit --audit-level=high",
    "security:audit-ci": "audit-ci --high",
    "security:semgrep": "semgrep scan --config semgrep.yml --error --metrics=off",
    "security:osv": "osv-scanner --lockfile=package-lock.json --lockfile=frontend/package-lock.json",
    "security:trivy:fs": "trivy fs --config trivy.yaml .",
    "security:trivy:validate-misconfig": "node scripts/validate-trivy-misconfig.js",
    "security:trivy:docker": "trivy image --config trivy.yaml aiempire-backend:ci",
    "docker:build": "docker build -t aiempire-backend:ci .",
    "certification:final": "node scripts/final-certification.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:coverage:final": "jest --coverage",
    "test:integration:coverage": "jest src/__tests__/integration --coverage",
    "test:e2e": "jest src/__tests__/e2e --coverage",
    "test:security": "npx ts-node ../tests/security/v60-pentest.ts",
    "test:load": "k6 run ../tests/load/v60-load-tests.js",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "db:migrate": "drizzle-kit push:pg",
    "db:migrate:sql": "ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "health:check": "curl -f http://localhost:3000/health",
    "v60:verify:guards": "grep -r 'from.*auth/guards' src/ --include='*.ts' | wc -l",
    "v60:verify:finance": "grep -r 'ProfitService\\|ProfitEngine' src/ --include='*.ts' | wc -l",
    "v60:verify:orchestrator": "grep -r 'BotOrchestratorService\\|AutonomousLoopService' src/ --include='*.ts' | wc -l",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "migrate:v64": "node src/database/migrations/run-v64-migrations.js",
    "postbuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist/migrations')) fs.cpSync('migrations', 'dist/migrations', {recursive:true});\"",
    "migrate:v65": "node src/database/migrations/run-v65-migrations.js",
    "certify": "node src/certification/production-gate.js",
    "certify:strict": "node src/certification/production-gate.js",
    "migrate:v66": "node src/database/migrations/run-v66-migrations.js",
    "prebuild": "ts-node -r tsconfig-paths/register src/certification/arch-guard.ts && node src/certification/production-gate.js",
    "migrate:v67": "node src/database/migrations/run-v67-migrations.js",
    "migrate:all": "node src/database/migrations/run-v66-migrations.js && node src/database/migrations/run-v67-migrations.js",
    "test:unit": "jest src/__tests__/unit --coverage",
    "test:all": "jest src/__tests__ --coverage",
    "validate:architecture": "ts-node -r tsconfig-paths/register src/certification/arch-guard.ts",
    "test:arch": "jest src/__tests__/unit/arch-guard.spec.ts --testPathPattern=arch",
    "openapi:generate": "jest src/__tests__/contract/openapi-generate.contract.spec.ts --runInBand",
    "test:contract": "jest src/__tests__/contract --runInBand --detectOpenHandles",
    "test:playwright": "playwright test"
  },
